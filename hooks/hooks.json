{
  "description": "Grava o diário ao fim da sessão e, no início, lembra de anotar decisões e pendências.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/retomar/scripts/diario.py\" lembrete", "timeout": 5}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/retomar/scripts/diario.py\" gravar", "timeout": 15}
        ]
      }
    ]
  }
}
